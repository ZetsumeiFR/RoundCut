# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url @sensitive=false
BETTER_AUTH_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Resend API key; without it, development prints emails to the server log
# @optional
RESEND_API_KEY=

# Sender address for transactional emails, e.g. "RoundCut <noreply@roundcut.app>"
# @optional
EMAIL_FROM=

# Google OAuth client (Google Cloud Console > Credentials > OAuth client ID, "Web application").
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Google sign-in is hidden until both values are set.
# @optional @sensitive=false
GOOGLE_CLIENT_ID=

# @optional
GOOGLE_CLIENT_SECRET=

# S3-compatible object storage for video uploads (VER-01): Cloudflare R2 in
# production, the docker-compose MinIO in development.
# R2: https://<account id>.eu.r2.cloudflarestorage.com (bucket in jurisdiction eu),
# with a bucket CORS rule allowing PUT from BETTER_AUTH_URL.
# MinIO: http://localhost:9000
# @type=url @sensitive=false
R2_ENDPOINT=

# @sensitive=false
R2_BUCKET=

# Public identifier: every presigned URL carries it (X-Amz-Credential).
# @sensitive=false
R2_ACCESS_KEY_ID=

R2_SECRET_ACCESS_KEY=
