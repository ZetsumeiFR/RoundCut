    "@roundcut/db": "workspace:*",
    "@roundcut/ui": "workspace:*",
    "@swc/helpers": "^0.5.24",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@varlock/nextjs-integration": "2.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-auth": "catalog:",
    "lucide-react": "catalog:",
    "next": "^16.4.6",
    "next-themes": "catalog:",
